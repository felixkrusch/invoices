# invoices — standalone contacts + invoicing
# Copy to .env and fill secrets before production deploy.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoices"
# Docker Compose sets this automatically from POSTGRES_PASSWORD.
POSTGRES_PASSWORD=""

# ---------------------------------------------------------------------------
# Auth.js (required in production)
# ---------------------------------------------------------------------------
# openssl rand -base64 48
AUTH_SECRET=""
# Public origin used in magic-link / invite / OAuth callbacks (no trailing slash)
AUTH_URL="http://localhost:3000"
# Behind nginx/caddy/traefik in production: must be "true"
AUTH_TRUST_HOST="false"
# Lab only — never on the public internet
AUTH_ALLOW_HTTP="false"

# Optional OAuth
# Redirect: {AUTH_URL}/api/auth/callback/google
#           {AUTH_URL}/api/auth/callback/microsoft-entra-id
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_ID=""
MICROSOFT_ENTRA_ID_SECRET=""
MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# ---------------------------------------------------------------------------
# Jobs / worker
# ---------------------------------------------------------------------------
# openssl rand -base64 48
JOB_RUNNER_SECRET=""
JOB_RUNNER_URL="http://127.0.0.1:3000"
JOB_RUNNER_INTERVAL_MS="5000"

# ---------------------------------------------------------------------------
# Email (magic links, invitations, send invoice)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourdomain.com"

# ---------------------------------------------------------------------------
# Encryption (file credentials / TOTP secrets) — 64 hex chars
# openssl rand -hex 32
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# License (30-day trial, then key — same model as entrytwo)
# ---------------------------------------------------------------------------
# Trial needs no key. After purchase, POST /api/license/activate calls this URL once
# with product=invoices. If unset, paid keys cannot activate (except the master key).
LICENSE_VERIFY_URL="https://entrytwo.com/api/license/verify"
# Optional purchase page link in trial UI
NEXT_PUBLIC_LICENSE_URL="https://entrytwo.com/buy?product=invoices"
# Branding in emails and authenticator apps
APP_DISPLAY_NAME="invoices"

# ---------------------------------------------------------------------------
# LLM (optional — chat assistant)
# ---------------------------------------------------------------------------
NEXT_LLM_PROVIDER="openai"
NEXT_LLM_MODEL="gpt-4o-mini"
NEXT_LLM_BASE_URL=""
OPENAI_API_KEY=""
XAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Payments (optional)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_BASE_URL="https://api-m.paypal.com"

# ---------------------------------------------------------------------------
# Self-hosted updates (optional — see docs/Self-Hosted-Update-Delivery.md)
# ---------------------------------------------------------------------------
UPDATE_MANIFEST_URL=""
# openssl rand -base64 48
UPDATER_TOKEN=""
UPDATER_URL="http://updater:4000"
APP_IMAGE="invoices:latest"
APP_VERSION="0.1.0"
APP_PUBLIC_URL="http://localhost:3000"
# Production compose requires UPDATER_TOKEN. For local `npm run dev` leave empty.
