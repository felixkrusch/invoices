generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY
  SUCCEEDED
  DEAD_LETTER
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  role              Role               @default(VIEWER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  fileAssets        FileAsset[]
  chatThreads       ChatThread[]
  totpSecret        String?
  totpEnabled       Boolean            @default(false)
  totpLastUsedStep  BigInt?
  totpRecoveryCodes TotpRecoveryCode[]
  settings          Json?
  sessionVersion    Int                @default(0)
  disabled          Boolean            @default(false)
  oauthAccounts     OAuthAccount[]
  invitationsCreated UserInvitation[]  @relation("InvitationCreator")
}

model OAuthAccount {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@unique([token])
  @@index([expires])
}

model UserInvitation {
  id          String    @id @default(uuid())
  email       String
  role        Role      @default(VIEWER)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String

  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([email, expiresAt])
}

model Contact {
  id                String             @id @default(uuid())
  name              String
  email             String?
  type              String
  phone             String?
  addressStreet     String?
  addressCity       String?
  addressState      String?
  addressZip        String?
  addressCountry    String?
  addressLine2      String?
  taxId             String?
  website           String?
  currency          String?
  preferredLanguage String?
  notes             String?
  vatValid          Boolean?
  vatValidated      Boolean            @default(false)
  vatValidatedAt    DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
}

model FileAsset {
  id           String   @id @default(uuid())
  storageKey   String   @unique
  storage      String   @default("local")
  originalName String
  mimeType     String
  size         Int
  sha256       String
  createdById  String
  createdAt    DateTime @default(now())

  createdBy    User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  chatMessages ChatMessageAttachment[]

  @@index([sha256])
  @@index([createdById, createdAt])
}

model ChatThread {
  id         String    @id @default(uuid())
  userId     String
  title      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime?
  archivedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([expiresAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  threadId       String
  role           String
  content        String
  action         String?
  metadata       Json?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  thread      ChatThread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments ChatMessageAttachment[]

  @@index([threadId, createdAt, id])
}

model ChatMessageAttachment {
  messageId   String
  fileAssetId String

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileAsset FileAsset   @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@id([messageId, fileAssetId])
  @@index([fileAssetId])
}

model TaxRate {
  id            String    @id @default(uuid())
  jurisdiction  String
  name          String
  rate          Decimal
  taxType       String
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoiceLines InvoiceLine[]
}

model DurableJob {
  id             String       @id @default(uuid())
  type           String
  idempotencyKey String       @unique
  payload        Json
  status         JobStatus    @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  availableAt    DateTime     @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attemptHistory JobAttempt[]

  @@index([status, availableAt])
  @@index([lockedAt])
}

model JobAttempt {
  id         String     @id @default(uuid())
  jobId      String
  attempt    Int
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  error      String?
  workerId   String
  job        DurableJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
}

model WebhookEvent {
  id          String                  @id @default(uuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  status      WebhookProcessingStatus @default(PENDING)
  attempts    Int                     @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([provider, externalId])
  @@index([status, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id                String   @id @default(uuid())
  name              String
  description       String?
  content           String?
  isInvoiceTemplate Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RecurringInvoice {
  id              String    @id @default(uuid())
  name            String
  contactId       String
  frequency       String
  interval        Int       @default(1)
  startDate       DateTime
  endDate         DateTime?
  nextDueDate     DateTime
  lastGeneratedAt DateTime?
  autoSend        Boolean   @default(false)
  status          String    @default("ACTIVE")
  notes           String?
  templateData    Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contact Contact @relation(fields: [contactId], references: [id])
}

model Invoice {
  id              String    @id @default(uuid())
  invoiceNumber   String    @unique
  contactId       String
  status          String
  currency        String    @default("EUR")
  language        String    @default("en")
  subtotal        Decimal
  taxAmount       Decimal
  total           Decimal
  issueDate       DateTime
  dueDate         DateTime
  paidDate        DateTime?
  notes           String?
  terms           String?
  templateData    Json?
  paymentLink     String?
  stripeInvoiceId String?
  paypalInvoiceId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contact Contact       @relation(fields: [contactId], references: [id])
  lines   InvoiceLine[]
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1)
  unitPrice   Decimal
  taxRateId   String?
  lineTotal   Decimal
  taxAmount   Decimal @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])
}

model TotpRecoveryCode {
  id        String   @id @default(uuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hash])
  @@index([userId])
}
